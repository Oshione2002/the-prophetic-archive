{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-prophetic-archive.invalid/schemas/catalogue.schema.json",
  "title": "The Prophetic Archive Catalogue",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "collections"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogueVersion": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "developmentFixture": {"type": "boolean"},
    "collections": {
      "type": "array",
      "items": {"$ref": "#/$defs/collection"}
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "responsiveText": {"type": "boolean"},
        "cleanPdf": {"type": "boolean"},
        "originalScan": {"type": "boolean"},
        "audio": {"type": "boolean"},
        "video": {"type": "boolean"},
        "bibleReader": {"type": "boolean"},
        "verseNavigation": {"type": "boolean"},
        "search": {"type": "boolean"}
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url", "fileSize", "sha256", "version"],
      "properties": {
        "url": {"type": "string"},
        "fileSize": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "collectionType": {"type": "string", "minLength": 1},
        "displayOrder": {"type": "integer"},
        "documentCount": {"type": "integer", "minimum": 0},
        "uniqueItemCount": {"type": "integer", "minimum": 0},
        "contentVersion": {"type": "integer", "minimum": 1},
        "downloadSize": {"type": "integer", "minimum": 0},
        "manifest": {"type": "string"},
        "pack": {"$ref": "#/$defs/pack"},
        "icon": {"type": "string"},
        "cover": {"type": "string"},
        "thumbnail": {"type": "string"},
        "translationCode": {"type": "string"},
        "sortMode": {"enum": ["ascending", "descending"]},
        "capabilities": {"$ref": "#/$defs/capabilities"}
      },
      "oneOf": [
        {"required": ["manifest"], "not": {"required": ["pack"]}},
        {"required": ["pack"], "not": {"required": ["manifest"]}}
      ]
    }
  }
}
