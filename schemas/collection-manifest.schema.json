{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-prophetic-archive.invalid/schemas/collection-manifest.schema.json",
  "title": "The Prophetic Archive Collection Manifest",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "collectionId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "contentVersion": {"type": "integer", "minimum": 1},
    "contentPattern": {"type": "string"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"type": "string"},
          {"$ref": "#/$defs/documentReference"},
          {"$ref": "#/$defs/document"}
        ]
      }
    }
  },
  "anyOf": [
    {"required": ["documents"]},
    {"required": ["contentPattern"]}
  ],
  "$defs": {
    "documentReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "json": {"type": "string"},
        "assets": {"type": "object"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "orderIndex": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "verse": {"type": "integer", "minimum": 1},
        "numberLabel": {"type": ["string", "null"]},
        "headingLevel": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
        "metadata": {"type": "object"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "fileType": {"type": "string"},
        "type": {"type": "string"},
        "remoteUrl": {"type": "string"},
        "url": {"type": "string"},
        "assetPath": {"type": "string"},
        "fileSize": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "version": {"type": "integer", "minimum": 1},
        "durationSeconds": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "collectionId": {"type": "string"},
        "collection": {"type": "string"},
        "displayTitle": {"type": "string"},
        "title": {"type": "string"},
        "documentType": {"type": "string"},
        "sortOrder": {"type": "integer"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "verses": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "metadata": {"type": "object"}
      }
    }
  }
}
